{
    "manifest_version": 3,
    "name": "SharePoint File Search",
    "version": "2.0",
    "description": "Search files by name in SharePoint folder",
    "permissions": [
        "cookies",
        "activeTab",
        "scripting",
        "storage",
        "tabs"
    ],
    "host_permissions": [
        "https://dxcportal.sharepoint.com/*",
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "SharePoint File Search"
    }
}